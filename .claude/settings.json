{
  "mcpServers": {
    "repo-management": {
      "command": "node",
      "args": ["../plugins/repo-management/dist/index.js"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git add *)"
    ]
  }
}

